{
  "model": {
    "backend": "openai", "model": "YOUR_VISION_MODEL_NAME", "base_url": "https://api.openai.com/v1",
    "api_key_env": "OPENAI_API_KEY", "supports_logprobs": false, "max_tokens": 1, "timeout": 60
  },
  "task": {"labels": ["finding_present", "finding_absent"], "question": "Does this image contain the specified finding?"},
  "scores": ["agreement"],
  "sampling": {"repeats": 8, "temperature": 1.0},
  "transform": {"name": "shearlet", "scales": 2},
  "image_size": 128,
  "explainer": {"steps": 10, "grid_size": 4, "max_requests": 500, "seed": 42},
  "max_total_requests": 500
}
